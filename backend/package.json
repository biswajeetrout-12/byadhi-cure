{
  "name": "byadhi-cure-backend",
  "version": "1.0.0",
  "description": "Backend API for Byadhi Cure Lab Private Limited",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon",
    "dev:debug": "nodemon --inspect"
  },
  "nodemonConfig": {
    "watch": [
      "*.js",
      "controllers",
      "routes",
      "middleware",
      "models",
      "services",
      "utils",
      "config"
    ],
    "ext": "js,json",
    "ignore": [
      "node_modules",
      "*.test.js",
      "*.spec.js"
    ],
    "delay": 300,
    "env": {
      "NODE_ENV": "development"
    }
  },
  "keywords": [
    "pharmaceutical",
    "byadhi",
    "backend",
    "express"
  ],
  "author": "Byadhi Cure Lab Pvt. Ltd.",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.3.4",
    "multer": "^2.3.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
